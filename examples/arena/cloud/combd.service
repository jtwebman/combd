# combd on a node, as its own user, no Docker. combd-update puts each
# version in /opt/combd/<source> and points /opt/combd/current at it.
[Unit]
Description=combd
After=network-online.target combd-tune.service
Wants=network-online.target

[Service]
User=combd
Group=combd
EnvironmentFile=/etc/combd/env
Environment=MALLOC_MMAP_THRESHOLD_=131072 MALLOC_MMAP_MAX_=4000000
WorkingDirectory=/opt/combd/current/spike
ExecStart=/opt/combd/current/spike/target/release/combd-spike serve-fleet both 443
Restart=always
RestartSec=1
LimitNOFILE=1048576
# Ports 80 and 443, and nothing else a root process could do.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Writes only its data; its secrets in /etc/combd are its own (600).
ProtectSystem=strict
ReadWritePaths=/var/lib/combd
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
# A backstop under Wasm's own rules, if a bug ever let code loose in combd:
# no memory both writable and executable (no JIT here; builds load from
# files), only the calls a service makes (a call outside them fails, EPERM,
# and combd goes on), and nothing on the machine it can run but itself, its
# libraries, and its builds: no shell, no curl. (The filter can't refuse
# execve: systemd needs it to start combd.)
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# Each place it can write is a mount of its own, which / doesn't cover:
# named, or a program dropped there would run. Its builds must load.
NoExecPaths=/ /tmp /var/tmp /dev/shm /var/lib/combd
ExecPaths=/opt/combd /usr/lib /usr/lib64 /var/lib/combd/builds

[Install]
WantedBy=multi-user.target

#cloud-config
# One arena node: the fleet's files, and combd as its own user (no Docker).
# Secrets arrive here (user data is readable only from the droplet itself)
# and only combd (and root) can read them.
package_update: true
write_files:
  - path: /etc/combd/certs/ca.pem
    encoding: b64
    content: ${base64encode(ca)}
  - path: /etc/combd/certs/node${node}.pem
    encoding: b64
    content: ${base64encode(cert)}
  - path: /etc/combd/certs/node${node}.key
    permissions: "0600"
    encoding: b64
    content: ${base64encode(key)}
  - path: /etc/combd/tokens
    permissions: "0600"
    encoding: b64
    content: ${base64encode(tokens)}
  - path: /etc/combd/master.key
    permissions: "0600"
    encoding: b64
    content: ${base64encode(master)}
  # combd ends HTTPS itself (on 443; 80 redirects): the arena's
  # certificate, which tls.sh replaces when it's renewed.
  - path: /etc/combd/tls/cert.pem
    encoding: b64
    content: ${base64encode(tls_cert)}
  - path: /etc/combd/tls/key.pem
    permissions: "0600"
    encoding: b64
    content: ${base64encode(tls_key)}
  # The builders whose builds of compiled modules this node loads.
  - path: /etc/combd/builder-keys
    encoding: b64
    content: ${base64encode(builders)}
  - path: /etc/combd/env
    permissions: "0600"
    encoding: b64
    content: ${base64encode(env)}
  # New versions roll out by themselves, one node at a time (combd-update).
  - path: /usr/local/bin/combd-update
    permissions: "0755"
    encoding: b64
    content: ${base64encode(update)}
  - path: /etc/combd/update
    content: |
      COMBD_RELEASE=${release}
  - path: /etc/systemd/system/combd.service
    encoding: b64
    content: ${base64encode(service)}
  # Kernel limits and a trimmed OS, at every boot, before combd (combd-tune).
  - path: /usr/local/bin/combd-tune
    permissions: "0755"
    encoding: b64
    content: ${base64encode(tune)}
  - path: /etc/systemd/system/combd-tune.service
    content: |
      [Unit]
      Description=Kernel limits and a trimmed OS for combd
      Before=combd.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/combd-tune
      [Install]
      WantedBy=multi-user.target
  - path: /etc/cron.d/combd-update
    content: |
      * * * * * root /usr/local/bin/combd-update
runcmd:
  # A little swap: 1 GB is tight.
  - fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile && echo '/swapfile none swap sw 0 0' >> /etc/fstab
  - useradd --system --home-dir /var/lib/combd --shell /usr/sbin/nologin combd
  - mkdir -p /var/lib/combd /opt/combd && chown combd:combd /var/lib/combd
  # Its secrets are its own, 600 (combd refuses a key others may read).
  - chown combd:combd /etc/combd/tokens /etc/combd/master.key /etc/combd/certs/node${node}.key /etc/combd/tls/key.pem && chmod 600 /etc/combd/tokens /etc/combd/master.key /etc/combd/certs/node${node}.key /etc/combd/tls/key.pem
  - systemctl daemon-reload && systemctl enable --now combd-tune && systemctl enable combd
  # The newest combd, and start it (if GitHub doesn't answer, cron tries again).
  - /usr/local/bin/combd-update now
